# Normalize line endings to LF in the repository on all platforms.
# On Windows checkout, Git will convert to CRLF locally.
* text=auto eol=lf

# Force LF for specific file types (Docker, shell scripts must use LF)
*.sh        eol=lf
Dockerfile  eol=lf
*.py        eol=lf
*.ts        eol=lf
*.tsx       eol=lf
*.js        eol=lf
*.json      eol=lf
*.md        eol=lf
*.yml       eol=lf
*.yaml      eol=lf
*.css       eol=lf
*.html      eol=lf
*.txt       eol=lf
*.ini       eol=lf
*.cfg       eol=lf

# Binary files — no line-ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
