# ─────────────────────────────────────────────────────────────────────────────
# Cortex Gateway — Backend Environment Variables
# Authoritative template covering all Phases 1 – 9E + Phase 10 production vars.
#
# Usage:
#   cp backend/.env.example backend/.env
#   # Edit .env with your values — NEVER commit .env to version control
#
# Connection URL strategy:
#   The application auto-composes DATABASE_URL and REDIS_URL from component
#   vars (POSTGRES_*, REDIS_*). Set DATABASE_URL / REDIS_URL directly only
#   to override (e.g., managed cloud database).
#
# Provider API keys:
#   Leave blank to disable a provider gracefully.
#   A missing key does NOT crash the gateway.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# Purpose:  Display name, version, environment mode
# Required: No
APP_NAME=Cortex Gateway
APP_VERSION=1.0.0
ENVIRONMENT=development        # development | production

# ── API Server ────────────────────────────────────────────────────────────────
# Purpose:  Uvicorn listen address and port
# Required: No (defaults shown)
API_HOST=0.0.0.0
API_PORT=8000

# ── Database: PostgreSQL ──────────────────────────────────────────────────────
# Purpose:  PostgreSQL connection — component vars are the source of truth
# Required: Yes (POSTGRES_PASSWORD must be changed in production)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cortex_gateway
POSTGRES_USER=cortex_user
POSTGRES_PASSWORD=change_me_in_production   # ← CHANGE THIS

# Override only when connecting to a managed cloud database (e.g. Supabase, RDS)
# Leave blank to auto-compose from POSTGRES_* vars above
DATABASE_URL=

# ── Cache: Redis ──────────────────────────────────────────────────────────────
# Purpose:  Redis connection — component vars are the source of truth
# Required: Yes (for rate limiting, semantic cache)
REDIS_HOST=redis
REDIS_PORT=6379

# Override only when connecting to managed Redis (e.g. Redis Cloud, ElastiCache)
# Leave blank to auto-compose from REDIS_* vars above
REDIS_URL=

# ── Security ──────────────────────────────────────────────────────────────────
# Purpose:  General secret key for signing/crypto operations
# Required: Yes — change before any production deployment
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_in_production          # ← CHANGE THIS (min 32 chars)

# ── Logging ───────────────────────────────────────────────────────────────────
# Purpose:  Structured log verbosity
# Required: No
LOG_LEVEL=INFO                              # DEBUG | INFO | WARNING | ERROR

# ── CORS ──────────────────────────────────────────────────────────────────────
# Purpose:  Allowed browser origins for cross-origin API requests
# Required: No (restrict in production)
CORS_ORIGINS=http://localhost:5173

# ── Provider: Global ──────────────────────────────────────────────────────────
# Purpose:  Fallback timeout and default routing hints
# Required: No
PROVIDER_TIMEOUT_SECONDS=30
DEFAULT_PROVIDER=
DEFAULT_MODEL=

# ── Provider: Google Gemini ───────────────────────────────────────────────────
# Purpose:  Google Gemini cloud LLM provider
# Required: No — leave blank to disable gracefully
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=30

# ── Provider: Groq ────────────────────────────────────────────────────────────
# Purpose:  Groq cloud LLM provider (Llama, Mixtral models)
# Required: No — leave blank to disable gracefully
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ENABLED=true
GROQ_TIMEOUT_SECONDS=30

# ── Provider: OpenAI ──────────────────────────────────────────────────────────
# Purpose:  OpenAI cloud LLM provider (disabled by default)
# Required: No
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ENABLED=false

# ── Provider: Ollama (Local / Self-hosted) ────────────────────────────────────
# Purpose:  Local Ollama LLM runtime — no API key required
# Required: No — requires a running Ollama instance
# Docker Compose: use http://ollama:11434 (internal network)
# Local dev:      use http://localhost:11434
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=60

# ── Routing Engine (Phase 3) ──────────────────────────────────────────────────
# Purpose:  Intelligent multi-provider routing configuration
# Required: No (defaults shown)
ROUTING_ENABLED=true
ROUTING_DEFAULT_MODE=auto    # auto | manual | lowest_cost | lowest_latency | best_available | capability_based
ROUTING_HEALTH_WEIGHT=0.30
ROUTING_SUCCESS_RATE_WEIGHT=0.30
ROUTING_LATENCY_WEIGHT=0.20
ROUTING_COST_WEIGHT=0.20
ROUTING_OLLAMA_COST_PER_1K=0.00

# ── Reliability & Resilience (Phase 4) ───────────────────────────────────────
# Purpose:  Retry, circuit breaker, failover configuration
# Required: No (defaults shown)
RELIABILITY_TOTAL_REQUEST_TIMEOUT_SECONDS=120
RELIABILITY_MAX_RETRIES=2
RELIABILITY_RETRY_BASE_DELAY_SECONDS=0.25
RELIABILITY_RETRY_MAX_DELAY_SECONDS=2.0
RELIABILITY_RETRY_JITTER=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0
CIRCUIT_BREAKER_HALF_OPEN_TRIALS=1
RELIABILITY_MAX_FAILOVER_ATTEMPTS=2

# ── Authentication & Multi-Tenancy (Phase 5) ──────────────────────────────────
# Purpose:  HMAC-SHA256 server-side pepper for API key hashing
# Required: Yes — MUST be changed in production
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER log, commit, or expose this value.
API_KEY_PEPPER=change-me-generate-a-random-secret-here  # ← CHANGE THIS

# ── Bootstrap (Phase 5) ───────────────────────────────────────────────────────
# Purpose:  One-time endpoint to create the first Organization + admin API key
# Required: Yes (for initial setup)
# Disable:  Set CORTEX_BOOTSTRAP_ENABLED=false after initial bootstrap
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CORTEX_BOOTSTRAP_ENABLED=true
CORTEX_BOOTSTRAP_TOKEN=change-me-in-production      # ← CHANGE THIS

# ── Rate Limiting (Phase 6) ───────────────────────────────────────────────────
# Purpose:  Redis-backed fixed-window rate limiting per key/team/org
# Required: No (enabled by default; set false to disable globally — not recommended)
RATE_LIMIT_ENABLED=true

# Per API key
RATE_LIMIT_API_KEY_REQUESTS=100
RATE_LIMIT_API_KEY_WINDOW_SECONDS=60

# Per team
RATE_LIMIT_TEAM_REQUESTS=500
RATE_LIMIT_TEAM_WINDOW_SECONDS=60

# Per organization
RATE_LIMIT_ORG_REQUESTS=2000
RATE_LIMIT_ORG_WINDOW_SECONDS=60

# ── Budget Management (Phase 6) ───────────────────────────────────────────────
# Purpose:  Team-level spending budgets backed by PostgreSQL
# Required: No (enabled by default)
BUDGET_ENABLED=true
BUDGET_DEFAULT_POLICY=BLOCK           # BLOCK | WARN | DOWNGRADE
BUDGET_WARNING_THRESHOLD_PERCENT=80
BUDGET_EXPOSE_REMAINING=false

# Ollama infrastructure cost accounting (0.00 = no per-token cost by default)
OLLAMA_COST_PER_1K_INPUT_TOKENS=0.00
OLLAMA_COST_PER_1K_OUTPUT_TOKENS=0.00

# ── Observability: Prometheus (Phase 7) ───────────────────────────────────────
# Purpose:  Expose GET /metrics in Prometheus text format
# Required: No
METRICS_ENABLED=true

# ── Observability: OpenTelemetry (Phase 7) ────────────────────────────────────
# Purpose:  Distributed tracing via OTLP gRPC exporter
# Required: No — gateway works normally without a collector
OTEL_ENABLED=false
OTEL_SERVICE_NAME=cortex-gateway
# gRPC endpoint, e.g. http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Observability: Request Log (Phase 7) ──────────────────────────────────────
# Purpose:  Persist one RequestLog row per completed request to PostgreSQL
# Required: No — set false only for local dev without a DB
REQUEST_LOG_ENABLED=true

# ── Semantic Cache (Phase 9B) ─────────────────────────────────────────────────
# Purpose:  Redis-backed embedding similarity cache for chat responses
# Required: No (off by default — must be explicitly enabled)
# Notes:    Requires Ollama with the embedding model pulled:
#             ollama pull nomic-embed-text
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_VERSION=v1
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_ENTRIES_PER_TEAM=500
SEMANTIC_CACHE_EMBEDDING_PROVIDER=ollama
SEMANTIC_CACHE_EMBEDDING_MODEL=nomic-embed-text

# ── Policy Engine (Phase 9C) ──────────────────────────────────────────────────
# Purpose:  Team-level policy is stored in the teams.policy_json DB column.
#           No additional environment variables are needed for Phase 9C.
#           Policy is configured via the Admin API:
#             PUT /api/v1/teams/{team_id}/policy
# Required: N/A — managed via API, not environment variables

# ── A/B Testing & Canary (Phase 9D) ──────────────────────────────────────────
# Purpose:  Traffic splitting experiments are stored in the DB via Admin API.
#           No additional environment variables are needed for Phase 9D.
#           Experiments are managed via the policy API.
# Required: N/A — managed via API, not environment variables

# ── Guardrails (Phase 9E) ─────────────────────────────────────────────────────
# Purpose:  Prompt safety checks (size, PII, injection).
#           Guardrails are configured per-team via the policy API:
#             PUT /api/v1/teams/{team_id}/policy
#             { "guardrails": { "pii_detection": "block", "max_prompt_length": 4096 } }
#           No additional environment variables are needed for Phase 9E.
#           Global defaults (all off) apply when no team policy is set.
# Required: N/A — managed via API, not environment variables

# ── Frontend (Phase 8) ────────────────────────────────────────────────────────
# Purpose:  Build-time variable consumed by Vite.
#           Set to the public URL of the backend API (used for browser → API calls).
#           Leave empty to use relative URLs (recommended when NGINX proxies /api/*).
# Required: No — set only for non-proxied deployments
VITE_API_URL=
