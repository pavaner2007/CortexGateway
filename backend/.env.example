# ─────────────────────────────────────────────────────────────────
# Cortex Gateway — Backend Environment Variables
#
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# SOURCE OF TRUTH:
#   Use the individual component variables (POSTGRES_*, REDIS_*).
#   DATABASE_URL and REDIS_URL are automatically composed by the
#   application.  You only need to set DATABASE_URL or REDIS_URL
#   if you want to override the auto-composed value (e.g., to point
#   at an external managed database).
#
# PROVIDER API KEYS:
#   Never commit real API keys to version control.
#   Leave keys blank to disable a provider gracefully.
#   A missing key does NOT crash the application.
# ─────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────
APP_NAME=Cortex Gateway
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# ── API Server ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── PostgreSQL (component vars — preferred source of truth) ───────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cortex_gateway
POSTGRES_USER=cortex_user
POSTGRES_PASSWORD=change_me       # ← CHANGE THIS

# ── PostgreSQL connection URL (leave blank to auto-compose) ───────
DATABASE_URL=

# ── Redis (component vars — preferred source of truth) ────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Redis connection URL (leave blank to auto-compose) ────────────
REDIS_URL=

# ── Security ──────────────────────────────────────────────────────
SECRET_KEY=change_me              # ← CHANGE THIS (min 32 chars recommended)

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# ── CORS (comma-separated list of allowed origins) ────────────────
CORS_ORIGINS=http://localhost:5173

# ── Provider: Global ─────────────────────────────────────────────
PROVIDER_TIMEOUT_SECONDS=30
DEFAULT_PROVIDER=
DEFAULT_MODEL=

# ── Provider: Google Gemini (Cloud) ──────────────────────────────
# Leave blank to disable Gemini provider gracefully.
GEMINI_API_KEY=
GEMINI_ENABLED=true

# ── Provider: Groq (Cloud) ───────────────────────────────────────
# Leave blank to disable Groq provider gracefully.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ENABLED=true

# ── Provider: Ollama (Local / Self-hosted) ───────────────────────
# Zero API keys required. Use http://localhost:11434 for local dev,
# or http://ollama:11434 when running inside Docker Compose.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=60

# ── Intelligent Routing Engine (Phase 3) ──────────────────────────
ROUTING_ENABLED=true
ROUTING_DEFAULT_MODE=auto         # manual | auto | lowest_cost | lowest_latency | best_available | capability_based
ROUTING_HEALTH_WEIGHT=0.30
ROUTING_SUCCESS_RATE_WEIGHT=0.30
ROUTING_LATENCY_WEIGHT=0.20
ROUTING_COST_WEIGHT=0.20
ROUTING_OLLAMA_COST_PER_1K=0.00   # Configurable cost for local Ollama models in USD

# ── Reliability & Resilience (Phase 4) ────────────────────────────
GEMINI_TIMEOUT_SECONDS=30
GROQ_TIMEOUT_SECONDS=30
OLLAMA_TIMEOUT_SECONDS=60
RELIABILITY_TOTAL_REQUEST_TIMEOUT_SECONDS=120
RELIABILITY_MAX_RETRIES=2
RELIABILITY_RETRY_BASE_DELAY_SECONDS=0.25
RELIABILITY_RETRY_MAX_DELAY_SECONDS=2.0
RELIABILITY_RETRY_JITTER=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0
CIRCUIT_BREAKER_HALF_OPEN_TRIALS=1
RELIABILITY_MAX_FAILOVER_ATTEMPTS=2

# ── Authentication & Multi-Tenancy (Phase 5) ───────────────────────
# HMAC-SHA256 pepper — used to hash API keys before storage.
# MUST be a long random secret. NEVER commit the real value.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY_PEPPER=change-me-generate-a-random-secret-here

# ── Bootstrap (Phase 5) ────────────────────────────────────────────
# One-time endpoint to create the first Organization + admin key.
# Set CORTEX_BOOTSTRAP_ENABLED=false to permanently disable bootstrap
# after initial setup.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CORTEX_BOOTSTRAP_ENABLED=true
CORTEX_BOOTSTRAP_TOKEN=change-me-in-production      # ← CHANGE THIS

# ── Rate Limiting (Phase 6) ────────────────────────────────────────
# Redis-backed fixed-window rate limiting.
# Set RATE_LIMIT_ENABLED=false to disable (not recommended in production).
RATE_LIMIT_ENABLED=true

# Per API key: max requests per window
RATE_LIMIT_API_KEY_REQUESTS=100
RATE_LIMIT_API_KEY_WINDOW_SECONDS=60

# Per team: max requests per window
RATE_LIMIT_TEAM_REQUESTS=500
RATE_LIMIT_TEAM_WINDOW_SECONDS=60

# Per organization: max requests per window
RATE_LIMIT_ORG_REQUESTS=2000
RATE_LIMIT_ORG_WINDOW_SECONDS=60

# ── Budget Management (Phase 6) ────────────────────────────────────
# Team-level spending budgets backed by PostgreSQL.
# Set BUDGET_ENABLED=false to disable budget enforcement globally.
BUDGET_ENABLED=true

# Default policy when a team's budget is exhausted:
#   BLOCK     — reject the request (HTTP 402)
#   WARN      — allow but log a structured warning
#   DOWNGRADE — route to a cheaper provider/model within budget
BUDGET_DEFAULT_POLICY=BLOCK

# Emit a structured warning log when usage reaches this % of the limit.
BUDGET_WARNING_THRESHOLD_PERCENT=80

# Set to true to include remaining_budget in response metadata.
# Default false to avoid exposing internal budget details.
BUDGET_EXPOSE_REMAINING=false

# ── Ollama Pricing (Phase 6) ───────────────────────────────────────
# Ollama is self-hosted and has no per-token API charge by default.
# Override to account for hosting/infrastructure costs if desired.
OLLAMA_COST_PER_1K_INPUT_TOKENS=0.00
OLLAMA_COST_PER_1K_OUTPUT_TOKENS=0.00
